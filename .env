# section1-App settings
# key should not be change unless starting fresh
APP_NAME=Laravel
APP_ENV=local               #Switch to production mode in live
APP_KEY=base64:Qec2y34K/hWT5KXb6fbWUOgrxivL45Xa6IRDXNvO8xo=
APP_DEBUG=true              #false in live
APP_URL=http://localhost    #Set real domain in live

# section-2-Localization
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# section-3-Maintenance
APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

# section-4-Security / hashing
BCRYPT_ROUNDS=12

#section-5-Logging
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug                 #error->Avoid debug in production

#section-6-db
DB_CONNECTION=mysql
DB_HOST=127.0.0.1               #your_server_ip in live
DB_PORT=3306
DB_DATABASE=products_system     #your_live_db
DB_USERNAME=root                #your_user
DB_PASSWORD=                    #strong_password

#section-7-Sessions
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false           # true for better security
SESSION_PATH=/
SESSION_DOMAIN=null             #.yourdomain.com

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local           #public if needed
#section-8-Queue / Cache
QUEUE_CONNECTION=database       #redis recommended if available

CACHE_STORE=database            #redis recommended if available
# CACHE_PREFIX=

#section-9-Redis / Memcached
MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

#section-10-Mail
MAIL_MAILER=log                 #smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1             #smtp.gmail.com
MAIL_PORT=2525                  #-587
MAIL_USERNAME=null              #your_email
MAIL_PASSWORD=null              #your_app_password
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

#section-11-AWS / Storage
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

#section-12-Frontend (Vite)
VITE_APP_NAME="${APP_NAME}"
